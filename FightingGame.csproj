<Project Sdk="Godot.NET.Sdk/4.6.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Facepunch.Steamworks" Version="2.3.3" />
  </ItemGroup>
  <ItemGroup>
    <!-- Steam's own library. The NuGet package ships it under content/, which PackageReference
         projects ignore, so it's kept in the project root and copied to the build output by hand.
         Windows only — other platforms need their own build of it. -->
    <None Include="steam_api64.dll" Condition="Exists('steam_api64.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>